SITE_URL=https://www.numu.bio

RESEND_API_KEY=
CONTACT_TO_EMAIL=andy@numu.bio
CONTACT_BCC_EMAIL=
RESEND_FROM_EMAIL="NUMU Website <notifications@numu.bio>"

# Optional comma-separated extra hosts allowed to post to contact routes.
ALLOWED_CONTACT_ORIGINS=

# Server-only investor settings. Use a separate random signing secret of at least 32 characters.
INVESTOR_PASSWORD=
INVESTOR_ACCESS_SECRET=
# Single-line JSON on Vercel. Keep the local story file out of Git and Vercel uploads.
INVESTOR_STORY_JSON=
INVESTOR_STORY_FILE=exports/private/investor-story.json
